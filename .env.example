# ==========================================
# Runtime
# ==========================================
APP_NAME=taskflow-api-dotnet
ENVIRONMENT=Production
PORT=3000
CORS_ORIGIN=https://taskflow-api-dotnet.xprad.com

# ==========================================
# Rate limiting (fixed window per IP)
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ==========================================
# PostgreSQL Cloud (vendor-agnostic)
# Runtime: pooler 6543. Migraciones EF Core: directo 5432.
# ==========================================
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST:5432/postgres?sslmode=require"