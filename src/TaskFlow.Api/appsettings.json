{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.RateLimiting": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "RateLimit": {
    "Enabled": true,
    "Requests": 120,
    "WindowSeconds": 60
  }
}